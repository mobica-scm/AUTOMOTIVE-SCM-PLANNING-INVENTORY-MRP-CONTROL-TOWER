# Copy to .env and fill in real values. Never commit .env itself.

# Postgres connection string. For Supabase: Project Settings -> Database
# -> Connection string -> "Transaction" pooler mode (port 6543) is what
# serverless/Vercel needs; the direct connection (port 5432) is fine for
# local dev and for running migrations from your own machine.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Signs the session cookie. Generate a real one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse the same value across environments.
SESSION_SECRET="replace-me"
